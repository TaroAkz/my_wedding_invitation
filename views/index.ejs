            <div class="couple-container">
                <div class="person">
                    <div class="title">កូនប្រុសនាម</div>
                    <img src="images/Groom_Photo.jpg" alt="Groom">
                    <div class="name">រឿម មករា</div>
                </div>
                <div class="person">
                    <div class="title">កូនស្រីនាម</div>
                    <img src="images/bride_photo.jpg" alt="Bride">
                    <div class="name">កែវ ក័ន្យារ៉ាត់</div>
                </div>
            </div>
            </section>

            <hr class="section-divider" />

            <section class="page relative text-center">
                <div class="info-box">
                  <h1 class="text-2xl font-bold mb-4">សិរីមង្គលអាពាហ៍ពិពាហ៍</h1>
                  <div class="text-base leading-relaxed space-y-1 mb-6">
                    <p>លោកស្រី ឡឹក សារួន &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; លោក កែវ សេដ្ខា</p>
                    <p>លោកស្រី ជា សាវី &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; លោកស្រី សាន សារី</p>
                    
                    <p class="mt-2 font-semibold text-lg">សុំគោរពអញ្ជើញ</p>
                    <p>សម្ដេច ទ្រង់ ឯកឧត្ដម អ្នកឧកញ៉ា ឧកញ៉ា លោកជំទាវ</p>
                    <p>លោក លោកស្រី អ្នកនាង កញ្ញា អញ្ចើញចូលរួមជា អធិបតី</p>
                    <p>និងជាភ្ញៀវកិត្តិយស ដើម្បីប្រសិទ្ធពរជ័យ សិរីសួស្ដី ជ័យមង្គល</p>
                    <p>ក្នុងពិធីរៀបអាពាហ៍ពិពាហ៍ កូនប្រុស-កូនស្រី របស់យើងខ្ញុំ</p>
                  </div>
                  <div class="flex justify-around font-bold text-lg px-6 mb-4">
                    <div>
                      <div>កូនប្រុស</div>
                      <div class="text-xl">រឿម មករា</div>
                    </div>
                    <div>
                      <div>កូនស្រី</div>
                      <div class="text-xl">កែវ ក័ន្យារ៉ាត់</div>
                    </div>
                  </div>
                  <div class="text-sm">
                    <p>នៅគេហដ្ឋានខាងប្រុស</p>
                    <p>ថ្ងៃសុក្រ ២ រោច ខែកត្តិក ឆ្នាំម្សាញ់ សប្តស័ក ពុទ្ធសករាជ ២៥៦៩</p>
                    <p>ត្រូវនឹងថ្ងៃទី៧ ខែវិច្ឆិកា ឆ្នាំ២០២៥</p>
                    <p>៥:០០នាទីល្ងាច</p>
                    <p class="mt-4">សូមគោរពអញ្ជើញមក</p>
                  </div>
                </div>
            </section>

