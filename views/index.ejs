    const landing = document.getElementById('landing');
    const invitation = document.getElementById('invitation');
    const bg = document.getElementById('myBackgroundMusic'); // <audio id="myBackgroundMusic">
    const enterBtn = document.getElementById('enterBtn');

    // Handle enter button click
    enterBtn.addEventListener('click', () => {
        // Try playing background music only after click
        if (bg) {
        bg.play().catch(err => console.log("Play failed:", err));
        }

        // Add fade-out + disable interaction
        landing.classList.add("opacity-0", "pointer-events-none");

        // After fade (0.5s), hide landing & show invitation
        setTimeout(() => {
        landing.style.display = "none"; 
        invitation.classList.remove("hidden");
        }, 500); 
    });
  </script>
