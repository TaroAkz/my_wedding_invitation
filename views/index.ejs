            <section class="invitation-name">
                <img src="images/overlay1.svg" alt="Flower" class="decor-top-left" />
                <img src="images/overlay1.svg" alt="Flower" class="decor-top-right" />
                <div class="invite-name">
                    <h2 class="invitation-message">សូមគោរពអញ្ជើញ</h2>
                    <div class="name-frame">
                        <div id="guest-title"><%= guestTitle %></div>
                    </div>
                    <div style="padding-top: 3mm;">
                        ចូលរួមជាភ្ញៀវកិត្តិយស ដល់គូរស្វាមី ភរិយាថ្មី នៅថ្ងៃដ៏ពិសេសនេះ
                    </div>
                </div>
